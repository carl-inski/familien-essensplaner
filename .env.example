# Supabase (Projekt-URL und Publishable/Anon-Key aus Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Öffentliche Basis-URL für Bring!-Links (optional; sonst wird die Request-URL verwendet)
NEXT_PUBLIC_SITE_URL=https://familien-essensplaner-umber.vercel.app

# KI (Phase 2) – anbieterunabhängig, nur serverseitig
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_VISION_MODEL=
LLM_API_KEY=
AI_DAILY_CALL_LIMIT=50
AI_MONTHLY_BUDGET_EUR=5

# Token für POST /api/suggestions (Samstags-Vorschläge, Phase 2)
SUGGESTIONS_TOKEN=
