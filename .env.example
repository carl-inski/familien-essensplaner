# Supabase (Projekt-URL und Publishable/Anon-Key aus Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Öffentliche Basis-URL für Bring!-Links (optional; sonst wird die Request-URL verwendet)
NEXT_PUBLIC_SITE_URL=https://familien-essensplaner-umber.vercel.app

# KI – anbieterunabhängig, nur serverseitig. Ohne Schlüssel zeigt die App „KI noch nicht eingerichtet“.
# LLM_PROVIDER: anthropic (Standard) | openai-compatible (z. B. Groq, OpenRouter) | mock (feste Testantworten) | off
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Modelle (leer = claude-haiku-5-5). Bild- und Stark-Modell fallen auf LLM_MODEL zurück.
LLM_MODEL=
LLM_VISION_MODEL=
LLM_MODEL_STRONG=
# Nur für openai-compatible, z. B. https://api.groq.com/openai/v1 oder https://openrouter.ai/api/v1
LLM_BASE_URL=
# Limits: Anfragen pro Person und Tag, Budget pro Haushalt und Monat
AI_DAILY_CALL_LIMIT=50
AI_MONTHLY_BUDGET_EUR=5
# Preise für die Kostenschätzung (Standard: Haiku 5.5, 0,10 $ / 0,50 $ pro Million Tokens)
AI_PRICE_IN_USD_PER_M=0.1
AI_PRICE_OUT_USD_PER_M=0.5
AI_USD_EUR=0.92

# Token für POST /api/suggestions (Samstags-Vorschläge, Phase 2)
SUGGESTIONS_TOKEN=
